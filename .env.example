# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TRG_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# Guard behaviour — the `train setup` wizard writes these for you in plain words.
# How often to check the weather at each parked car (minutes, 5-240)
TRG_CHECK_INTERVAL_MINUTES=20
# "Rain is imminent" look-ahead window (minutes, 10-360)
TRG_RAIN_LEAD_MINUTES=60
# Forecast rain probability that counts as rain (0-1)
TRG_RAIN_PROB_THRESHOLD=0.5
# Don't re-send the same window command within this many minutes
TRG_COOLDOWN_MINUTES=30
# Hot-day heat vent: crack windows when cabin >= this (Celsius), no rain for
# TRG_VENT_RAIN_CLEAR_HOURS hours. Set TRG_VENT_ENABLE=0 to turn off.
TRG_VENT_ENABLE=1
TRG_VENT_CABIN_TEMP_C=40
TRG_VENT_RAIN_CLEAR_HOURS=3
# Where guard decisions are logged (the chat explains itself from this log)
TRG_DECISION_LOG=~/.train/decision-log.jsonl
# Free weather service (no key needed). Any Open-Meteo-compatible endpoint works.
TRG_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
TRG_WEATHER_TIMEOUT_SECONDS=15

# The OpenAI-compatible server THIS app exposes
TRG_SERVER_HOST=127.0.0.1
TRG_SERVER_PORT=8643
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TRG_SERVER_API_KEY=
TRG_MODEL_ID=tesla-rain-guard

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# Point at OpenAI, Groq, LM Studio, llama.cpp, ... or leave Ollama defaults.
# The app works FULLY without a backend (rules engine); the LLM only handles
# free-form questions. Vehicle data is sent only to this backend — nowhere else.
TRG_AI_BASE_URL=http://localhost:11434/v1
TRG_AI_API_KEY=
TRG_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TRG_AI_MODE=auto
TRG_AI_TIMEOUT_SECONDS=20

TRG_EMBEDDING_DIM=384
TRG_TOKEN_FILE=~/.train/tokens.json
# 1 = report commands instead of sending them
TRG_DRY_RUN=0
